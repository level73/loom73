# Router - exclude images, docs, scripts, fonts
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Request is an explicit file or directory
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Exclude routing for images, css & js, fonts, including asset directories
  RewriteCond %{REQUEST_URI} !\.(png|jpg|jpeg|gif|svg|ico)$
  RewriteCond %{REQUEST_URI} !\.(pdf|doc|docx|xls|xlsx|rtf|ods|xml)$
  RewriteCond %{REQUEST_URI} !\.(css|js|less|scss|json)$
  RewriteCond %{REQUEST_URI} !\.(eot|ttf|otf|woff|woff2)$
  RewriteCond %{REQUEST_URI} !^/(css|js|assets|resources)/$

  # Route everything to index.php and attach querystring params
  RewriteRule ^(.*)$ index.php?url=$1 [PT,QSA,L]
</IfModule>
# Cache expiry for assets, resources, scripts
<IfModule mod_expires.c>
    ExpiresActive on
    # Content type
    AddType font/woff           .woff
    AddType font/woff2          .woff2
    AddType font/otf            .otf
    AddType font/ttf            .ttf
    AddType text/css            .css
    AddType image/svg+xml       .svg
    AddType image/webp          .webp
    AddType image/png           .png

    # Web fonts
    ExpiresByType text/css      "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp    "access plus 1 year"
    ExpiresByType image/png     "access plus 1 year"
    ExpiresByType font/woff     "access plus 1 year"
    ExpiresByType font/woff2    "access plus 1 year"
    ExpiresByType font/ttf      "access plus 1 year"
    ExpiresByType font/otf      "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  # No caching for `.html` and `.php` files
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Heavily cache all other assets
  <FilesMatch "\.(jpg|jpeg|gif|png|webp|avif|svg|ico|css|js|woff2|woff|eot|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Block from crawling/indexing
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# BasicAuth, becasue this stuff is in dev
AuthType Basic
AuthName "Loom73"
AuthUserFile /var/www/loom73.lvl73.it/.htpasswd
Require valid-user
